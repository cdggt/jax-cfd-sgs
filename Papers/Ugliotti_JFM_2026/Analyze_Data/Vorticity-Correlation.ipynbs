   "cell_type": "markdown",
   "id": "3c96e283",
   "metadata": {},
   "source": [
    "Vorticity Correlations Plots — Figure 9\n",
    "\n",
    "This notebook does:\n",
    "\n",
    "1. Load a DNS and LES vorticity field `w(t,x,y)` from a NetCDF file (variable name: `w`).\n",
    "2. Compute the vorticity correlation over time\n",
    "3. Plot it and save the data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "e124fac9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ----------------------------\n",
    "# Imports & configuration\n",
    "# ----------------------------\n",
    "from __future__ import annotations\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import xarray as xr\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "import jax\n",
    "import jax.numpy as jnp\n",
    "\n",
    "import jax_cfd.base as cfd\n",
    "import jax_cfd.base.grids as grids\n",
    "import jax_cfd.spectral as spectral\n",
    "\n",
    "jax.config.update(\"jax_enable_x64\", True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "27b4254c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "50 2048 2048\n",
      "50 256 256\n"
     ]
    }
   ],
   "source": [
    "# ----------------------------\n",
    "# User knobs\n",
    "# ----------------------------\n",
    "INP_DNS = Path(\"/storage/home/hcoda1/4/mugliotti3/scratch/temporary/DNS.nc\")   #where DNS is saved\n",
    "INP_LES = Path(\"/storage/home/hcoda1/4/mugliotti3/scratch/temporary/LES.nc\")   #where LES is saved\n",
    "\n",
    "OUT_DIR = Path(\"/storage/home/hcoda1/4/mugliotti3/scratch/temporary/\")         #where to save\n",
    "OUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "OUT_PATH = OUT_DIR / \"w_Correlations.txt\"\n",
    "\n",
    "ds_DNS = xr.open_dataset(INP_DNS)                #import DNS\n",
    "w_DNS = jnp.asarray(ds_DNS[\"w\"].values)\n",
    "Nt_DNS, Nx_DNS, Ny_DNS = w_DNS.shape\n",
    "print(Nt_DNS, Nx_DNS, Ny_DNS)\n",
    "del ds_DNS\n",
    "\n",
    "ds_LES = xr.open_dataset(INP_LES)                #import LES\n",
    "w_LES = jnp.asarray(ds_LES[\"w\"].values)\n",
    "Nt_LES, Nx_LES, Ny_LES = w_LES.shape\n",
    "print(Nt_LES, Nx_LES, Ny_LES)\n",
    "del ds_LES\n",
    "assert Nt_DNS == Nt_LES\n",
    "\n",
    "Delta = 6*jnp.pi/Nx_LES                          #if you had a different Delta change this\n",
    "T_eddy = 1/jnp.mean(jnp.sqrt(w_DNS[0,:,:]**2))   #to normalize time by"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "b709ada8",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x500 with 4 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ----------------------------\n",
    "# Quick Sanity Check\n",
    "# ----------------------------\n",
    "idx = 0  \n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 5), constrained_layout=True)\n",
    "\n",
    "vmax_dns = np.max(np.abs(w_DNS[idx, :, :]))\n",
    "im0 = axes[0].imshow(w_DNS[idx, :, :],origin=\"lower\",cmap=\"RdBu_r\",extent=[0, 2*np.pi, 0, 2*np.pi],vmin=-vmax_dns,vmax=vmax_dns,)\n",
    "axes[0].set_title(\"DNS initial vorticity\")\n",
    "axes[0].set_xlabel(\"x\")\n",
    "axes[0].set_ylabel(\"y\")\n",
    "fig.colorbar(im0, ax=axes[0], fraction=0.046, pad=0.04, label=\"ω\")\n",
    "vmax_les = np.max(np.abs(w_LES[idx, :, :]))\n",
    "im1 = axes[1].imshow(w_LES[idx, :, :],origin=\"lower\",cmap=\"RdBu_r\",extent=[0, 2*np.pi, 0, 2*np.pi],vmin=-vmax_les,vmax=vmax_les,)\n",
    "axes[1].set_title(\"LES initial vorticity\")\n",
    "axes[1].set_xlabel(\"x\")\n",
    "axes[1].set_ylabel(\"y\")\n",
    "fig.colorbar(im1, ax=axes[1], fraction=0.046, pad=0.04, label=\"ω\")\n",
    "\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "236a79f2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ----------------------------\n",
    "# Some functions we might need\n",
    "# ----------------------------\n",
    "\n",
    "from jax import vmap\n",
    "def fourier_filter(field, Delta):\n",
    "\n",
    "    if field.ndim not in (2, 3, 4):\n",
    "        raise ValueError(\"field must have 2D, 3D, or 4D shape\")\n",
    "\n",
    "    Nx, Ny = field.shape[:2]\n",
    "\n",
    "    qx = jnp.fft.fftfreq(Nx) * Nx\n",
    "    qy = jnp.fft.fftfreq(Ny) * Ny\n",
    "    X, Y = jnp.meshgrid(qy, qx)\n",
    "    R2 = X**2 + Y**2\n",
    "    G = jnp.exp(-R2 * (Delta**2) / 24.0).astype(field.dtype)\n",
    "\n",
    "    def filt2(x2d):\n",
    "        F = jnp.fft.fft2(x2d, axes=(-2, -1))\n",
    "        Y = F * G\n",
    "        y = jnp.fft.ifft2(Y, axes=(-2, -1))\n",
    "        return y.real.astype(field.dtype) if jnp.isrealobj(field) else y.astype(field.dtype)\n",
    "\n",
    "    if field.ndim == 2:\n",
    "        return filt2(field)\n",
    "\n",
    "    elif field.ndim == 3:  # (Nx,Ny,C)\n",
    "        return vmap(filt2, in_axes=2, out_axes=2)(field)\n",
    "\n",
    "    else:  # (Nx,Ny,C,T)\n",
    "        def filt3(x3d):  # x3d = (Nx,Ny,C)\n",
    "            return vmap(filt2, in_axes=2, out_axes=2)(x3d)\n",
    "        return vmap(filt3, in_axes=3, out_axes=3)(field)\n",
    "\n",
    "EPS = 1e-30\n",
    "\n",
    "def correlations(wles_xy: jnp.ndarray, wdns_xy: jnp.ndarray) -> jnp.ndarray:\n",
    "    num = jnp.mean(wles_xy * wdns_xy)\n",
    "    den_les = jnp.mean(wles_xy * wles_xy)\n",
    "    den_dns = jnp.mean(wdns_xy * wdns_xy)\n",
    "    den = jnp.maximum(den_les, den_dns) + EPS\n",
    "    return num / den"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "3392d488",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ----------------------------\n",
    "# Compute the correlations \n",
    "# ----------------------------\n",
    "\n",
    "dns_filter_vmap = vmap(lambda x: fourier_filter(x, float(Delta)), in_axes=0, out_axes=0)\n",
    "w_dns_filt = dns_filter_vmap(w_DNS) \n",
    "w_dns_filt_hat = jnp.fft.rfftn(w_dns_filt,axes=(1,2))\n",
    "down_vmap = vmap(lambda x: spectral.utils.down_res(x, [Nx_LES, Ny_LES]), in_axes=0, out_axes=0)\n",
    "w_DNS_down_hat = down_vmap(w_dns_filt_hat)  \n",
    "w_DNS_down = jnp.fft.irfftn(w_DNS_down_hat,axes=(1,2))\n",
    "\n",
    "Corr_vmap = vmap(correlations, in_axes=(0, 0), out_axes=0)\n",
    "A_prime = Corr_vmap(w_LES, w_DNS_down)  "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "93035d3f",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 600x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ----------------------------\n",
    "# Plot \n",
    "# ----------------------------\n",
    "A_prime_np = np.asarray(A_prime)\n",
    "\n",
    "plt.figure(figsize=(6,4))\n",
    "plt.plot(np.arange(A_prime_np.shape[0])/T_eddy, A_prime_np, linewidth=2)\n",
    "plt.xlabel(r\"t/$T_e$\")\n",
    "plt.ylabel(\"A'()\")\n",
    "plt.title(\"Vorticity correlation A'(ω) over time\")\n",
    "plt.grid(alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "e6cc5227",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Saved -> /storage/home/hcoda1/4/mugliotti3/scratch/temporary/w_Correlations.txt\n"
     ]
    }
   ],
   "source": [
    "# ----------------------------\n",
    "# Save it \n",
    "# ----------------------------\n",
    "t_over_T = np.arange(A_prime_np.shape[0]) / T_eddy\n",
    "\n",
    "with open(OUT_PATH, \"w\") as f:\n",
    "    f.write(\"t/T_eddy\\n\")\n",
    "    f.write(\" \".join(map(str, t_over_T)))\n",
    "    f.write(\"\\n\")\n",
    "    f.write(\"Correlation\\n\")\n",
    "    f.write(\" \".join(map(str, A_prime_np)))\n",
    "\n",
    "print(f\"Saved -> {OUT_PATH}\")"
   ]
  }
 ],
